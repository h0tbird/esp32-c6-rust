{
    "version": "2.0.0",
    "options": {
        "env": {
            "CLANG_PATH": "/opt/homebrew/opt/llvm/bin/clang",
            "LIBCLANG_PATH": "/opt/homebrew/opt/llvm/lib"
        }
    },
    "tasks": [
        {
            "label": "build-release",
            "command": "cargo",
            "args": ["build", "--release", "--locked"],
            "type": "process",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "clippy",
            "command": "cargo",
            "args": ["clippy", "--release", "--locked", "--bins", "--", "-D", "warnings"],
            "type": "process",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "flash-and-monitor",
            "command": "cargo",
            "args": ["run", "--release", "--locked"],
            "type": "process",
            "problemMatcher": ["$rustc"]
        }
    ]
}
